{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ironwood-forms",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],

  // Custom domain for the form backend. Kept deliberately separate from the
  // main site's Worker (ironwood-livigno) — a form-submission API and a
  // static marketing site have nothing to do with each other operationally,
  // and this way a bad deploy of one can never take down the other.
  "routes": [
    {
      "pattern": "forms.ironwoodlivigno.com",
      "custom_domain": true
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ironwood-forms",
      "database_id": "f7a04b87-646b-435d-895d-609e8372d668"
    }
  ],

  // Weekly JSON export of the whole submissions table (see the "0 4 * * SUN"
  // cron below) — D1's own replication protects against infrastructure
  // failure, not against a bad migration or an accidental DELETE run
  // against the wrong WHERE clause. A separate bucket, not a folder in the
  // existing `guida-ironwood` R2 bucket, so this Worker's own IAM/token
  // scope never needs access to anything outside its own data.
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "ironwood-forms-backups"
    }
  ],

  // Translates the guest's free-text message to Italian for the
  // notification, and drafts AI-assisted reply text — Cloudflare Workers AI
  // (@cf/zai-org/glm-4.7-flash, see src/translate.ts and src/draft.ts),
  // same account, no third-party AI API/key.
  "ai": {
    "binding": "AI"
  },

  // No send_email binding: ironwoodlivigno.com's MX records already point
  // to mailbox.org (the real, working inbox) and Cloudflare's Email
  // Service can only deliver to destination addresses verified through
  // Email Routing — which requires Email Routing enabled on the domain,
  // i.e. replacing those MX records. Not an option. The notification is
  // sent over SMTP directly to mailbox.org instead (see src/smtp.ts),
  // authenticated with the SMTP_PASSWORD secret (`wrangler secret put`).

  // 5 requests / 60s per IP (CF-Connecting-IP). Cloudflare's `simple` rate
  // limiter only supports a 10s or 60s window, so this is the tightest
  // single-binding window available — combined with the honeypot and
  // server-side validation below, sufficient defense-in-depth for a
  // low-traffic booking-request form without needing a CAPTCHA.
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    // Separate, tighter budget for /admin/login attempts (see auth.ts) —
    // brute-forcing the dashboard password is a different threat than a
    // guest submitting the booking form too often, so it gets its own
    // namespace rather than sharing FORM_RATE_LIMITER's budget.
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],

  // Three independent schedules, all handled in scheduled() in src/index.ts:
  // - "0 3 1 * *": monthly retention sweep (1st of the month, 03:00 UTC)
  // - "0 6 * * *": daily SMTP connectivity check (06:00 UTC) — catches a
  //   broken mailbox.org connection during a quiet period with no real
  //   form submissions, instead of only discovering it when a real guest
  //   request fails to notify.
  // - "0 4 * * SUN": weekly D1 → R2 backup (Sunday, 04:00 UTC).
  "triggers": {
    "crons": ["0 3 1 * *", "0 6 * * *", "0 4 * * SUN"]
  }
}
