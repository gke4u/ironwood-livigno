// Deploys the static site (the `out/` folder produced by `npm run build`)
// straight to the existing "ironwood-livigno" Worker via the command line,
// as a reliable alternative to the Cloudflare dashboard's drag-and-drop
// upload — which can hang/stall when uploading 100+ small files at once
// (a known issue with the dashboard uploader, see Cloudflare community
// reports). The `name` below matches the existing production Worker
// exactly, so deploying with this file updates that same site/domain —
// it does not create a new project.
//
// One-time setup, then to publish an update after `npm run build`:
//   npx wrangler login      (opens a browser once, to connect your account)
//   npx wrangler deploy
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ironwood-livigno",
	"compatibility_date": "2026-08-03",
	// Server-side code for the photo admin and the homepage "photo of the
	// day" (see worker/index.ts). Only the paths in run_worker_first reach
	// it; every other request is served from ./out exactly as before,
	// without invoking the Worker.
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/admin", "/admin/*", "/api/admin/*", "/api/offer", "/foto-del-giorno", "/foto/*", "/foto-google/*", "/recensione", "/api/sezioni", "/api/visita",
			"/it", "/en", "/de", "/fr", "/da", "/pl", "/cs", "/no", "/nl", "/zh", "/ja", "/en-us"]
	},
	// Uploaded photos. Secrets (set once with `npx wrangler secret put`):
	// ADMIN_PASSWORD (the /admin login) and SESSION_SECRET (signs the login cookie);
	// GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET once Google approves the Business
	// Profile API access (until then the Google link stays off, see worker/google.ts).
	"kv_namespaces": [{ "binding": "PHOTOS", "id": "5ebaedb7d16849278ddb91bed172f73d" }],
	// Visit counter for the admin (worker/stats.ts): one SQLite-backed Durable Object.
	"durable_objects": { "bindings": [{ "name": "STATS", "class_name": "Stats" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }],
	// Mondays 07:00 UTC (8 or 9 in Italy): the weekly photo for Google.
	"triggers": { "crons": ["0 7 * * 1"] }
}
